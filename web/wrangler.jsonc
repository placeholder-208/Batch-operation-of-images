{
  "name": "batch-operation-of-images",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "LINK_PREVIEW_LIMITER",
      "namespace_id": "61006001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SEMANTIC_LIMITER",
      "namespace_id": "61008002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "keep_vars": true
}
